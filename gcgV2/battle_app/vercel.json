{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/games.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,**/__pycache__/**,**/*.pyc,.understand-anything/**,out/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/games/:path*",
      "destination": "/api/games?path=:path*"
    }
  ]
}
