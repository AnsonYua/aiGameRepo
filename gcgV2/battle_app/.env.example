# battle_app local environment template.
# Copy to .env.local for local-only values. Do not commit real secrets.

# AI player mode. Accepted values:
# - hermes: Hermes Agent LLM decision path, current local UI default.
# - mcts: Monte Carlo Tree Search decision path; use GCG_BATTLE_INTERPRETER=schema.
# - llm: legacy DeepSeek/Codex-style LLM player path; requires GCG_DEEPSEEK_API_KEY.
# - scripted: deterministic test player; use GCG_BATTLE_INTERPRETER=reference.
GCG_BATTLE_AI_MODE=hermes

# Card effect interpreter. Accepted values:
# - schema: deterministic structured card-effect schema path; recommended for hermes/mcts.
# - llm: LLM effect interpreter; requires GCG_DEEPSEEK_API_KEY.
# - reference: ST01-only offline reference interpreter for tests/dev scenarios.
GCG_BATTLE_INTERPRETER=schema

# Optional local battle_app feature flags.
# GCG_ENABLE_SCENARIO_MODE=1
# GCG_ENABLE_MANUAL_MODE=1

# Optional structured card-effect schema file paths (colon-separated).
# Overrides the default auto-detection (docs/ → battle_app/schemas/ fallback).
# GCG_CARD_EFFECT_SCHEMA_PATHS=

# Optional Hermes timeout, only used when GCG_BATTLE_AI_MODE=hermes.
# GCG_HERMES_TIMEOUT_SECONDS=60

# Optional MCTS tuning, only used when GCG_BATTLE_AI_MODE=mcts.
# GCG_MCTS_ITERATIONS=200
# GCG_MCTS_TIME_BUDGET_MS=5000
# GCG_MCTS_ROLLOUT_DEPTH=20
# GCG_MCTS_EPSILON=0.15
# GCG_MCTS_EXPLORATION_C=1.4
# GCG_MCTS_SEED=42

# Optional old LLM path / LLM effect interpreter settings.
# GCG_DEEPSEEK_API_KEY=
# GCG_DEEPSEEK_BASE_URL=https://api.deepseek.com
# GCG_DEEPSEEK_MODEL=deepseek-chat
# GCG_AI_TIMEOUT_SECONDS=60

# Required only for Vercel/serverless Mongo storage.
# Set this in Vercel Project Settings for deployed environments.
# MONGODB_URI=
